{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self'; connect-src 'self' https://autkqbfgniopxldszdur.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action https://buy.stripe.com https://checkout.stripe.com"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/maintenance", "destination": "/maintenance.html" },
    { "source": "/age-restricted", "destination": "/age-restricted.html" },
    { "source": "/terms",    "destination": "/terms.html" },
    { "source": "/privacy",  "destination": "/privacy.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/ron",      "destination": "/ron.html" },
    { "source": "/historia", "destination": "/historia.html" },
    { "source": "/tours",    "destination": "/tours.html" },
    { "source": "/producto", "destination": "/producto.html" },
    { "source": "/plaza",    "destination": "/plaza.html" },
    { "source": "/cart",     "destination": "/cart.html" },
    { "source": "/login",    "destination": "/login.html" },
    { "source": "/signup",   "destination": "/signup.html" },
    { "source": "/account",  "destination": "/account.html" },
    { "source": "/account/orders", "destination": "/account/orders.html" },
    { "source": "/pickup-checkout", "destination": "/pickup-checkout.html" },
    { "source": "/pickup-confirmation", "destination": "/pickup-confirmation.html" },
    { "source": "/identity-return", "destination": "/identity-return.html" },
    { "source": "/auth/callback", "destination": "/auth/callback.html" },
    { "source": "/tour-confirmation", "destination": "/tour-confirmation.html" },
    { "source": "/success", "destination": "/success.html" },
    { "source": "/cancel", "destination": "/cancel.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/orders", "destination": "/admin/orders.html" }
  ]
}
