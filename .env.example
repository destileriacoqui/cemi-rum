NEXT_PUBLIC_SUPABASE_URL=https://autkqbfgniopxldszdur.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_URL=https://cemi-rum.vercel.app

# Server-side only. Configure these in Vercel. Never expose them in browser code.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shipping is a flat $20 charge applied once per shipped Stripe Checkout Session.
# Stripe Identity uses STRIPE_SECRET_KEY. Enable Identity in the Stripe Dashboard before launch.

# Staff order dashboard. Server-side only.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional second full-access staff account.
ADMIN_USERNAME_2=
ADMIN_PASSWORD_2=

# Required. At least 64 random characters to sign admin session cookies.
ADMIN_SESSION_SECRET=

# Canonical site URL for Stripe and auth redirects. No trailing slash.
SITE_URL=https://cemi-rum.vercel.app

# Customer emails from the staff dashboard. Server-side only.
RESEND_API_KEY=
ADMIN_EMAIL_FROM=Destilería Coquí <orders@prsugar.com>
# Optional: customer replies go to this inbox.
ADMIN_EMAIL_REPLY_TO=orders@prsugar.com

# Temporary public maintenance gate. Set MAINTENANCE_MODE=false and redeploy after launch.
MAINTENANCE_MODE=false
MAINTENANCE_OWNER_PASSWORD=
# Optional dedicated signing secret. When omitted, ADMIN_SESSION_SECRET is used.
MAINTENANCE_SESSION_SECRET=
