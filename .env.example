NEXT_PUBLIC_SUPABASE_URL=https://autkqbfgniopxldszdur.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Configure these in Vercel. Never expose them in browser code.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shipping is a flat $20 charge applied once per shipped Stripe Checkout Session.
# Stripe Identity uses STRIPE_SECRET_KEY. Enable Identity in the Stripe Dashboard before launch.

# Staff order dashboard. Server-side only.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional but recommended. Use a long random value to sign admin cookies.
ADMIN_SESSION_SECRET=

# Customer emails from the staff dashboard. Server-side only.
RESEND_API_KEY=
ADMIN_EMAIL_FROM=Destilería Coquí <orders@prsugar.com>
# Optional: customer replies go to this inbox.
ADMIN_EMAIL_REPLY_TO=orders@prsugar.com
